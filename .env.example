# 复制本文件为 .env 并填入真实值：copy .env.example .env

# IMAP 服务器（QQ 邮箱固定为 imap.qq.com:993）
QQ_MAIL_HOST=imap.qq.com
QQ_MAIL_PORT=993
QQ_MAIL_TIMEOUT=30

# 登录账号：完整邮箱地址
QQ_MAIL_USER=your_account@qq.com

# 授权码：QQ 邮箱网页版「设置 -> 账户 -> IMAP/SMTP服务」生成
QQ_MAIL_AUTH=your_authorization_code

# Home Assistant（供 actions/xiaoai-voice-action.py 让小爱音箱朗读）
HA_URL=http://192.168.1.117:8123
HA_TOKEN=your_ha_long_lived_access_token
# 小爱音箱实体：text.* 走 text/set_value（小米官方集成的「播放文本」）
# 也可以填 media_player.xxx，此时改用 tts/speak，需要再配 HA_TTS_ENTITY
HA_XIAOAI_ENTITY_ID=text.xiaomi_l05b_13c7_play_text
# HA_DRY_RUN=1   调试用：只打印将要发送的内容，不真正调用 HA
